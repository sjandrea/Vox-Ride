<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>VoxPilot @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" rootVolumeOnly="true" hostArchitectures="x86_64,arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>

    <choices-outline>
        <line choice="au"/>
        <line choice="vst3"/>
    </choices-outline>

    <choice id="au" title="Audio Unit (Logic Pro, GarageBand, MainStage)"
            description="Installeres i /Library/Audio/Plug-Ins/Components">
        <pkg-ref id="com.sbaudio.voxpilot.au"/>
    </choice>
    <choice id="vst3" title="VST3 (Ableton Live, Cubase, Studio One, Reaper …)"
            description="Installeres i /Library/Audio/Plug-Ins/VST3">
        <pkg-ref id="com.sbaudio.voxpilot.vst3"/>
    </choice>

    <pkg-ref id="com.sbaudio.voxpilot.au" version="@VERSION@">VoxPilot-AU.pkg</pkg-ref>
    <pkg-ref id="com.sbaudio.voxpilot.vst3" version="@VERSION@">VoxPilot-VST3.pkg</pkg-ref>
</installer-gui-script>
